{
    "buildCommand": "node scripts/generate-sitemap.js",
    "outputDirectory": ".",
    "routes": [
        { "handle": "filesystem" },
        {
            "src": "/(.*)",
            "headers": {
                "X-Content-Type-Options": "nosniff",
                "X-Frame-Options": "DENY",
                "Referrer-Policy": "strict-origin-when-cross-origin"
            },
            "continue": true
        },
        { "src": "/", "dest": "/index.html" },
        { "src": "/balance", "dest": "/index.html" },
        { "src": "/comingSoon", "dest": "/index.html" },
        { "src": "/(.*)", "status": 404, "dest": "/index.html" }
    ]
}